amends "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  // File hygiene
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  ["end-of-file-fixer"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace

  // oxfmt/oxlint are aube devDeps, so run through aube rather than a global install
  ["oxfmt"] {
    glob = List("**/*.ts", "**/*.tsx", "**/*.mts", "**/*.js", "**/*.mjs", "**/*.css", "**/*.json")
    exclude = List("aube-lock.yaml")
    check = "aube exec --no-install oxfmt --check {{files}}"
    fix = "aube exec --no-install oxfmt --write {{files}}"
  }
  ["oxlint"] {
    glob = List("**/*.ts", "**/*.tsx", "**/*.mts", "**/*.js", "**/*.mjs", "**/*.astro")
    check = "aube exec --no-install oxlint {{files}}"
    fix = "aube exec --no-install oxlint --fix {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
