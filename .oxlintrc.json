{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "import/no-unassigned-import": "off",
    "no-await-in-loop": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error"
  },
  "ignorePatterns": ["dist", ".astro", "node_modules", "site"],
  "overrides": [
    {
      "files": ["src/lib/pacts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "pacts import nothing first-party outside pacts."
              },
              {
                "regex": "^node:",
                "message": "pacts and mills import nothing with side effects."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/specs.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": ".*",
                "message": "specs are plain constants; they import nothing."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/mills/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(.*/)?(links|gates|inits|client|components|layouts|pages)(\\.ts)?(/|$)",
                "message": "mills import pacts only."
              },
              {
                "regex": "^node:",
                "message": "pacts and mills import nothing with side effects."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/links/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(.*/)?(mills|specs|gates|inits|client|components|layouts|pages)(\\.ts)?(/|$)",
                "message": "links import pacts only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/pages/**",
        "src/layouts/**",
        "src/components/**",
        "src/lib/client/**",
        "src/lib/gates/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/(.*/)?(mills|specs|links|inits)(\\.ts)?(/|$)",
                "message": "gates import pacts only; services come from locals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/inits.ts", "src/middleware.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/(.*/)?specs(\\.ts)?(/|$)",
                "message": "specs are for mills alone; inits wires, it does not decide."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "src/lib/__fixtures__/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
