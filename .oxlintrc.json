{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "import/no-unassigned-import": "off",
    "no-await-in-loop": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error"
  },
  "ignorePatterns": ["dist", ".astro", "node_modules", "site"],
  "overrides": [
    {
      "files": ["src/lib/pacts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./",
                "message": "pacts import nothing first-party outside pacts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/mills/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(links|inits|client|components|layouts|pages)(/|$)",
                "message": "mills import pacts only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/links/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+(mills|inits|client|components|layouts|pages)(/|$)",
                "message": "links import pacts only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**", "src/layouts/**", "src/components/**", "src/lib/client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/(.*/)?(mills|links|inits)(/|$)",
                "message": "gates import pacts only; services come from locals."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "src/lib/__fixtures__/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
