{
  "dashboards": [
    {
      "id": "main",
      "name": "Main",
      "repos": ["owner/repo", "owner/other-repo"],
      "users": ["@me"],
      "epicLabel": "epic",
      "sort": { "by": "updated", "dir": "desc" },
      "refreshMinutes": 5,
      "swimlanes": [
        {
          "id": "fix",
          "name": "PRs to fix",
          "filter": "is:pr is:conflicting|ci:failed|unanswered"
        },
        {
          "id": "high",
          "name": "High priority",
          "filter": "label:prio:high",
          "hideBlocked": false
        },
        { "id": "normal", "name": "Normal", "filter": "label:prio:normal", "hideBlocked": true },
        { "id": "rest", "name": "Unprioritised", "filter": "other", "hideBlocked": true }
      ],
      "columns": [
        { "id": "backlog", "name": "Backlog", "filter": "label:backlog" },
        {
          "id": "ready",
          "name": "Ready",
          "filter": "other -label:backlog"
        },
        { "id": "doing", "name": "In progress", "filter": "label:phase:doing" },
        {
          "id": "review",
          "name": "In review",
          "filter": "label:phase:review|\"needs review\" -label:wait"
        },
        { "id": "stuck", "name": "Review blocked", "filter": "label:phase:review label:wait" }
      ]
    }
  ]
}
