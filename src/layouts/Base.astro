---
import "../styles/global.css";

import Nav from "../components/Nav";

interface Props {
  title: string;
}

const { title } = Astro.props;
const nav = await Astro.locals.services.views.nav();
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · landschaft</title>
  </head>
  <body class="flex h-full flex-col bg-neutral-100 font-sans text-neutral-800 antialiased">
    <Nav client:load path={Astro.url.pathname} nav={nav} />
    <main class="min-h-0 flex-1">
      <slot />
    </main>
  </body>
</html>
