---
import "../styles/global.css";

import Nav from "../components/Nav";

import { getApp } from "../lib/server/app";
import { scopedIssues } from "../lib/server/board";
import { loadConfig } from "../lib/server/config";

interface Props {
  title: string;
}

const { title } = Astro.props;
const { dashboards, repos, users } = loadConfig();
const { db, syncer } = getApp();
const viewer = await syncer.viewer().catch(() => null);
const issues = db.listIssues(repos);
const tabs = dashboards.map(({ id, name, filter }) => {
  const scoped = scopedIssues(issues, { filter }, users, viewer);
  return { id, name, repos: [...new Set(scoped.map((issue) => issue.repo))] };
});
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · landschaft</title>
  </head>
  <body class="flex h-full flex-col bg-neutral-100 font-sans text-neutral-800 antialiased">
    <Nav client:load path={Astro.url.pathname} dashboards={tabs} repos={repos} />
    <main class="min-h-0 flex-1">
      <slot />
    </main>
  </body>
</html>
