---
import Base from "../layouts/Base.astro";
import { loadConfig } from "../lib/server/config";

const { dashboards } = loadConfig();
---

<Base title="Dashboards">
  <div class="mx-auto max-w-2xl p-6">
    <h1 class="mb-5 page-title">Dashboards</h1>
    {
      dashboards.length === 0 ? (
        <p class="text-neutral-600">
          No dashboards yet.{" "}
          <a href="/settings" class="text-sky-700 underline">
            Create one in settings
          </a>{" "}
          after adding the repositories to watch: a board with swimlanes and columns, or an inbox
          of groups.
        </p>
      ) : (
        <ul class="grid gap-3 sm:grid-cols-2">
          {dashboards.map((dashboard) => (
            <li>
              <a
                href={`/d/${dashboard.id}`}
                class="panel block p-4 transition hover:border-neutral-300 hover:shadow-md"
              >
                <div class="font-semibold text-neutral-900">{dashboard.name}</div>
                <div class="mt-1 truncate font-mono text-xs text-neutral-500">
                  {dashboard.filter || "all items"}
                </div>
                <div class="mt-2 text-xs text-neutral-500">
                  {dashboard.type === "board"
                    ? `board · ${dashboard.swimlanes.length} swimlanes · ${dashboard.columns.length} columns`
                    : `inbox · ${dashboard.groups.length} groups`}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
