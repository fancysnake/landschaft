---
import Board from "../../components/board/Board";
import Inbox from "../../components/board/Inbox";
import Base from "../../layouts/Base.astro";
import { findDashboard, loadConfig } from "../../lib/links/config/file";

const id = Astro.params.id ?? "";
const dashboard = findDashboard(loadConfig(), id);
if (!dashboard) return Astro.redirect("/", 302);
---

<Base title={dashboard.name}>
  {
    dashboard.type === "inbox" ? (
      <Inbox client:only="react" dashboardId={dashboard.id} />
    ) : (
      <Board client:only="react" dashboardId={dashboard.id} />
    )
  }
</Base>
